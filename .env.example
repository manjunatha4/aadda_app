# ==============================================================================
# AADDA Environment Variables Configuration
# ==============================================================================

NODE_ENV=development
PORT=4000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://aadda_user:aadda_secret_password@localhost:5432/aadda_db?schema=public"

# Redis (Socket.IO Adapter & Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expirations
JWT_ACCESS_SECRET="aadda-ultra-secure-access-jwt-secret-key-32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="aadda-ultra-secure-refresh-jwt-secret-key-32chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Argon2id Hashing Salt / Pepper
ARGON2_SECRET="aadda_pepper_key_kannada_chaos"

# MinIO / S3 Object Storage for Media Uploads
S3_ENDPOINT="localhost"
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY="aadda_minio_admin"
S3_SECRET_KEY="aadda_minio_password"
S3_BUCKET_NAME="aadda-media"

# Mobile App Public API URL
EXPO_PUBLIC_API_URL="http://localhost:4000/api"
EXPO_PUBLIC_SOCKET_URL="http://localhost:4000"

