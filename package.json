{
  "name": "aadda-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AADDA — Your people. Your chaos. Invite-only private digital hangout for close friend circles with Kannada-first localization.",
  "scripts": {
    "build": "pnpm --recursive run build",
    "build:web": "pnpm --filter @aadda/shared run build && pnpm --filter @aadda/mobile run export:web",
    "dev:api": "pnpm --filter @aadda/api run start:dev",
    "dev:mobile": "pnpm --filter @aadda/mobile run start",
    "prisma:generate": "pnpm --filter @aadda/api run prisma:generate",
    "prisma:migrate": "pnpm --filter @aadda/api run prisma:migrate",
    "prisma:seed": "pnpm --filter @aadda/api run prisma:seed",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --recursive run test"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@12.16.1"
}
